# =============================================================================
# Veilleur - Variables d'environnement
# =============================================================================
# Copier ce fichier vers .env et modifier les valeurs
# cp .env.example .env

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000

# =============================================================================
# Base de données MariaDB
# =============================================================================
# Pour Docker (utiliser le nom du service)
DATABASE_URL=mysql://veilleur:veilleur_secret@mariadb:3306/veilleur

# Pour développement local (sans Docker)
# DATABASE_URL=mysql://veilleur:motdepasse@localhost:3306/veilleur

# Mots de passe MariaDB (utilisés par Docker)
MARIADB_ROOT_PASSWORD=root_secret_change_me
MARIADB_PASSWORD=veilleur_secret

# Port exposé sur l'hôte
DB_PORT=3306

# =============================================================================
# Cache Redis
# =============================================================================
# Pour Docker (utiliser le nom du service)
REDIS_URL=redis://redis:6379

# Pour développement local (sans Docker)
# REDIS_URL=redis://localhost:6379

# Port exposé sur l'hôte
REDIS_PORT=6379

# =============================================================================
# Authentification JWT
# =============================================================================
# IMPORTANT : Changer ces valeurs en production !
# Générer avec : openssl rand -base64 32
JWT_SECRET=votre-secret-jwt-tres-long-et-aleatoire-a-changer
JWT_REFRESH_SECRET=autre-secret-pour-refresh-tokens-a-changer

# Durées des tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Scraping
# =============================================================================
SCRAPING_USER_AGENT=Veilleur/1.0 (+https://github.com/yrbane/veilleur)
SCRAPING_RATE_LIMIT_MS=5000
SCRAPING_MAX_RETRIES=3
SCRAPING_TIMEOUT_MS=10000

# =============================================================================
# Outils de debug (Docker)
# =============================================================================
# Ports pour les interfaces d'administration
ADMINER_PORT=8080
REDIS_UI_PORT=8081

# =============================================================================
# Logs
# =============================================================================
LOG_LEVEL=debug
# Options: trace, debug, info, warn, error, fatal

# =============================================================================
# Performance
# =============================================================================
# Cache TTL par défaut (en secondes)
CACHE_DEFAULT_TTL=1800

# Nombre max de connexions BDD
DB_POOL_SIZE=10
