{
  "name": "veilleur",
  "version": "0.18.0",
  "description": "Agrégateur d'actualités libre - Votre sentinelle de l'information",
  "type": "module",
  "scripts": {
    "dev": "npx concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "vite --port 5173",
    "build": "npm run typecheck && npm run build:server && npm run build:client",
    "build:server": "node scripts/build-serveur.mjs",
    "build:client": "vite build",
    "start": "NODE_ENV=production node dist/serveur.js",
    "start:dev": "tsx src/index.ts",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/infrastructure/persistence/seed.ts",
    "db:migrate:prod": "node dist/migrer.js",
    "db:seed:prod": "node dist/seed.js",
    "images:rattraper:prod": "node dist/rattraper-images.js",
    "mots-cles:rattraper:prod": "node dist/rattraper-mots-cles.js",
    "sources:rattraper:prod": "node dist/rattraper-sources.js",
    "deploy:nethttp": "bash scripts/deploy-nethttp.sh",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "news",
    "rss",
    "aggregator",
    "veilleur",
    "actualites"
  ],
  "author": "Veilleur Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yrbane/veilleur.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@material-symbols/font-400": "^0.48.0",
    "@mozilla/readability": "^0.6.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "bullmq": "^5.34.8",
    "cheerio": "^1.0.0",
    "drizzle-orm": "^0.38.2",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "jsdom": "^29.1.1",
    "lunar-aurora": "github:yrbane/lunar-aurora",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.1.7",
    "otpauth": "^9.4.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/sharp": "^0.31.1",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "terser": "^5.46.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^2.1.8"
  }
}
