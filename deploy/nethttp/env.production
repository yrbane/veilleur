# Veilleur — environnement de production (news.nethttp.net)
# Modèle : installer.sh le copie en /var/www/nethttp.net/news/.env au premier déploiement
# et remplace les __SECRETS__. Ce fichier n'est jamais écrasé ensuite.
NODE_ENV=production
HOST=127.0.0.1
PORT=8090
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=https://news.nethttp.net

# MariaDB locale
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=veilleur
DB_PASSWORD=__DB_PASSWORD__
DB_NAME=veilleur

# Redis local, base 1 (la base 0 est utilisée par websec)
REDIS_URL=redis://127.0.0.1:6379/1

# JWT
JWT_SECRET=__JWT_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__

# Cache d'images (seul chemin inscriptible du service)
IMAGES_CHEMIN_STOCKAGE=/var/www/nethttp.net/news/data/images

# Scraping
SCRAPING_USER_AGENT=Veilleur/0.2 (+https://news.nethttp.net)
